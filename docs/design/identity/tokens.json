{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "status": "draft",
    "target": "tui"
  },
  "color": {
    "role": {
      "primary": {
        "$value": "#7aa2f7",
        "$type": "color"
      },
      "accent": {
        "$value": "#bb9af7",
        "$type": "color"
      },
      "success": {
        "$value": "#9ece6a",
        "$type": "color"
      },
      "warning": {
        "$value": "#e0af68",
        "$type": "color"
      },
      "error": {
        "$value": "#f7768e",
        "$type": "color"
      },
      "muted": {
        "$value": "#565f89",
        "$type": "color"
      },
      "background": {
        "$value": "#1a1b26",
        "$type": "color"
      },
      "foreground": {
        "$value": "#c0caf5",
        "$type": "color"
      }
    }
  },
  "typography": {
    "styles": {
      "$value": {
        "title": [
          "bold"
        ],
        "emphasis": [
          "bold"
        ],
        "dim": [
          "faint"
        ],
        "selected": [
          "bold"
        ],
        "added": [],
        "removed": [],
        "hunk": [
          "bold"
        ]
      },
      "$type": "other"
    }
  }
}
